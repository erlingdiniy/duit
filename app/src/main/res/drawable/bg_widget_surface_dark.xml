<?xml version="1.0" encoding="utf-8"?>
<!-- Candy Bubble 2.0 card: soft gradient plus three layered bubbles. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="135" android:startColor="#FF2A4149" android:centerColor="#FF263B43" android:endColor="#FF213439" />
            <stroke android:width="1dp" android:color="#664A6870" />
        </shape>
    </item>
    <item android:gravity="top|end" android:width="84dp" android:height="84dp" android:top="6dp" android:end="6dp">
        <shape android:shape="oval"><solid android:color="#33FF836B" /></shape>
    </item>
    <item android:gravity="top|end" android:width="40dp" android:height="40dp" android:top="58dp" android:end="62dp">
        <shape android:shape="oval"><solid android:color="#3379DCC6" /></shape>
    </item>
    <item android:gravity="bottom|start" android:width="46dp" android:height="46dp" android:bottom="8dp" android:start="8dp">
        <shape android:shape="oval"><solid android:color="#26FFB84D" /></shape>
    </item>
</layer-list>
