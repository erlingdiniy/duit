<?xml version="1.0" encoding="utf-8"?>
<!-- Safe to Spend card (Candy Bubble 2.0): cream-to-coral wash with layered bubbles. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="0" android:startColor="#FFFFF6EE" android:centerColor="#FFFFECE3" android:endColor="#FFFFDCD2" />
            <stroke android:width="1.5dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item android:gravity="top|end" android:width="38dp" android:height="38dp" android:top="10dp" android:end="128dp">
        <shape android:shape="oval"><solid android:color="#4DFFFFFF" /></shape>
    </item>
    <item android:gravity="top|start" android:width="70dp" android:height="26dp" android:top="6dp" android:start="18dp">
        <shape android:shape="oval"><solid android:color="#59FFFFFF" /></shape>
    </item>
</layer-list>
