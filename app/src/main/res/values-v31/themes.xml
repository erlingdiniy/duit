<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash is plain cream (no icon) and hands straight over to the
         animated Compose splash, so two identical splash screens are never shown. -->
    <style name="Theme.Duit" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/splash_cream</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowBackground">@color/splash_cream</item>
    </style>
</resources>
