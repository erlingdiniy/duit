<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".DuitApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Duit">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Duit"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notifications.ReminderBootAndTimeReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widgets.DuitBalanceWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_balance_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duit_balance_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.DuitUpcomingPaymentsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_upcoming_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duit_upcoming_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.DuitSavingsGoalsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_savings_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duit_savings_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.DuitQuickAddWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quick_add_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duit_quick_add_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.DuitWalletsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_wallets_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duit_wallets_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.DuitBudgetWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_budget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duit_budget_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.DuitPulseWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_pulse_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duit_pulse_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.DuitPaydayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_payday_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duit_payday_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.DuitSummaryWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_summary_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duit_summary_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.DuitCommitmentsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_commitments_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duit_commitments_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.DuitBuddyWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_buddy_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duit_buddy_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.DuitPrivacyWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_privacy_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duit_privacy_widget_info" />
        </receiver>
    </application>

</manifest>
